# HTTPS automático (Let's Encrypt). DOMAIN e ACME_EMAIL vêm do .env via compose.
{
	email {$ACME_EMAIL}
	# Ativa o endpoint de admin só dentro do container (usado no healthcheck).
	admin 127.0.0.1:2019
	servers {
		# CLOUDFLARE: ao colocar o site atrás da Cloudflare (proxy laranja),
		# descomente o bloco abaixo para o Caddy enxergar o IP real do visitante.
		# Lembre de manter a lista de IPs da Cloudflare atualizada
		# (https://www.cloudflare.com/ips/) e usar SSL/TLS "Full (strict)" no painel.
		# trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		# client_ip_headers CF-Connecting-IP
	}
}

# www e HTTP caem no domínio principal em HTTPS (HTTP -> HTTPS o Caddy já faz sozinho).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}
}
